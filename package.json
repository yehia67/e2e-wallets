{
  "name": "wallets-e2e",
  "version": "0.0.0",
  "description": "Playwright commands and fixtures for driving real wallet extensions in E2E tests, built from source, no mocks. Leather (Stacks) and MetaMask (any EVM network) are supported; more wallets coming soon.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yehia67/e2e-wallets.git"
  },
  "bugs": {
    "url": "https://github.com/yehia67/e2e-wallets/issues"
  },
  "homepage": "https://github.com/yehia67/e2e-wallets#readme",
  "packageManager": "pnpm@9.11.0",
  "engines": {
    "node": ">=22.18"
  },
  "keywords": [
    "playwright",
    "stacks",
    "bitcoin",
    "xverse",
    "leather",
    "ethereum",
    "evm",
    "metamask",
    "wallet",
    "e2e",
    "blockchain",
    "web3"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:leather": "pnpm --filter @wallets-e2e/leather build:extension",
    "build:metamask": "pnpm --filter @wallets-e2e/metamask build:extension",
    "test": "turbo run test",
    "build:skill": "node scripts/build-claude-skill.mjs"
  },
  "devDependencies": {
    "@stacks/transactions": "^7.6.0",
    "@stacks/wallet-sdk": "^7.6.0",
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}

{
  "name": "playwright-stacks-wallet",
  "version": "0.0.0",
  "description": "Playwright commands and fixtures for driving real Stacks wallet extensions in E2E tests, built from source, no mocks. Leather is supported now; more wallets coming soon.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.11.0",
  "keywords": [
    "playwright",
    "stacks",
    "xverse",
    "leather",
    "wallet",
    "e2e",
    "blockchain",
    "web3"
  ],
  "scripts": {
    "build": "turbo run build",
    "build:leather": "pnpm --filter @stacks-wallet/leather build:extension",
    "test": "turbo run test"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.6.3"
  }
}

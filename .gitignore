node_modules/
.cache/
.turbo/
.env
.env.local
*.log
.DS_Store

# Built wallet extensions (fetched/built by setup scripts, not committed)
wallets/*/dist/
wallets/*/build/
wallets/*/.*-source/

# Compiled npm package output (real build, per Story 1.5 -- publish it, don't commit it)
packages/*/dist/
wallets/*/lib/

# Example app build output
examples/*/dist/

# Playwright output
test-results/
playwright-report/
blob-report/

# playwright-bdd's generated specs — compiled from features/**/*.feature by `bddgen` on every run
.features-gen/

# TypeScript build info
*.tsbuildinfo

# Internal planning tooling — not relevant to contributors, not part of the public project history
_bmad/
_bmad-output/
.claude/

# MetaMask fixture secrets (never commit)
wallets/metamask/.env.local
examples/metamask-spike/.env.local
examples/metamask-spike/deployed.json
examples/metamask-spike/public/deployed.json
examples/metamask-spike/out/
examples/metamask-spike/lib/
examples/metamask-spike/cache/

{
  "name": "@wallets-e2e/core",
  "version": "0.1.4",
  "type": "module",
  "description": "Drive real browser-extension wallets in Playwright end-to-end tests: launches the extension-loaded context, resolves the extension ID, defines the WalletDriver port, and confirms transactions on-chain. The base for @wallets-e2e/metamask and @wallets-e2e/leather.",
  "keywords": [
    "playwright",
    "stacks",
    "bitcoin",
    "ethereum",
    "evm",
    "leather",
    "wallet",
    "e2e",
    "blockchain",
    "web3",
    "browser-extension"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yehia67/e2e-wallets.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/yehia67/e2e-wallets/issues"
  },
  "homepage": "https://github.com/yehia67/e2e-wallets#readme",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bdd": {
      "types": "./dist/bdd/index.d.ts",
      "default": "./dist/bdd/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "!src/**/*.test.ts"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test"
  },
  "peerDependencies": {
    "@playwright/test": "^1.47.0",
    "playwright-bdd": "^9.2.0"
  },
  "peerDependenciesMeta": {
    "playwright-bdd": {
      "optional": true
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.47.0",
    "@types/node": "^22.7.5",
    "@types/chrome": "^0.2.7",
    "playwright-bdd": "^9.2.0",
    "typescript": "^5.6.3"
  }
}
